# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project across various editors and IDEs
# For more information, visit https://EditorConfig.org

root = true

# Top-level settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 120

# Java source files
[*.java]
tab_width = 4

# XML files (e.g., pom.xml, Spring configs)
[*.xml]
indent_size = 2

# YAML files (application.yml, etc)
[{*.yml,*.yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# TypeScript, JavaScript, and JSON files
[{*.ts,*.tsx,*.js,*.jsx,*.json}]
indent_size = 2

# CSS files
[*.css]
indent_size = 2

# Ignore minified files
[*.min.js]
insert_final_newline = false
trim_trailing_whitespace = false
